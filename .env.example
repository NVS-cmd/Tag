# Скопируйте в .env:  cp .env.example .env   — и поменяйте пароли.
# Файл .env НЕ коммитится и НЕ пересылается в чат.

DJANGO_SECRET_KEY=поменяйте-на-длинную-случайную-строку
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Порт на вашем компьютере (если 8000 занят — поставьте 8080)
APP_PORT=8000
# Добавьте сюда IP компьютера в сети, чтобы открыть с телефона, например:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.1.50
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.1.50:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=поменяйте-пароль-базы

# Откуда брать образы Docker (Docker Hub из РФ работает нестабильно).
# Если mirror.gcr.io не скачивается — попробуйте dockerhub.timeweb.cloud/library/... или dockerhub1.beget.com/library/...
PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine

# Демо-режим: разрешает `make demo-reset` (стирает всё и заполняет заново)
DEMO_MODE=1
DEMO_PASSWORD=demo12345demo
